# Copy to storage.env, fill the two key lines, import into Vercel (Settings, Environment Variables, Import .env). Never commit storage.env.
STORAGE_DRIVER=s3
S3_BUCKET=ownerlisting-files
S3_REGION=ap-southeast-2
S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_FORCE_PATH_STYLE=1
S3_SSE=none
S3_CONDITIONAL_PUT=0
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMAGE_SANITISER=sharp
