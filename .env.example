# OwnerListing environment. Copy to .env (never commit real values).
# Never put real credentials in source control.
NODE_ENV=development
# Investor projects module, master key (two-key switch: also needs the super-admin switch on /staff/investments/settings).
# Anything but exactly "true" keeps the module off (404). Keep false until counsel signs off (docs/COUNSEL_QUESTIONS.md section 9).
INVESTMENT_MODULE_ENABLED=false

# "FAILS CLOSED" = when unset the feature refuses to work; nothing is silently allowed.
# Before a deploy run `npm run check:providers -- --production` (docs/PROVIDER_KEYS.md): it names missing, wrong or placeholder keys.
# tests/env-example.test.ts checks every env key read in src/, app/ and scripts/ is listed here.

# --- Map tiles (src/domain/map-tiles.ts, app/listings/leaflet.ts) ---
# Listing page map, search map, staff listings map and location picker. openstreetmap = OpenStreetMap's own tiles: free, no key,
# attribution shown on every map. Their tile policy allows light use only; if traffic grows set custom and a paid or self-hosted provider.
# custom = NEXT_PUBLIC_MAP_TILE_URL (https, with {z} {x} {y}) and NEXT_PUBLIC_MAP_ATTRIBUTION. Baked in at build: redeploy after changing.
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Brand (one source of truth: src/config/brand.ts) ---
# Shown in titles, header, home page and consent text. NEXT_PUBLIC_SITE_NAME wins over SITE_NAME. Default OwnerListing. Not fail closed.
# NEXT_PUBLIC_* is baked in at build time on Vercel: change it, then redeploy.
NEXT_PUBLIC_SITE_NAME=
SITE_NAME=
NEXT_PUBLIC_SITE_TAGLINE=
SITE_TAGLINE=

# --- Site appearance preview (admin-controlled theme, see docs/SITE_APPEARANCE.md) ---
# Signs the short-lived (15 minute) ?theme_preview= token that lets staff view the unpublished draft theme on the public site.
# 32+ random characters; set the SAME value on the public and the admin deployment (openssl rand -base64 48). Not the session secret.
# FAILS CLOSED: unset or under 32 characters = the editor's Preview is off and the public site never shows a draft.
# On the admin deployment also set APP_URL to the public site's address (used only to build the preview address).
THEME_PREVIEW_SECRET=

# --- White-label agency domains (see docs/WHITE_LABEL.md) ---
# Comma-separated host names that are the platform's own (for example the public site and www). Agencies may not claim these or their subdomains,
# and requests to them skip the agency lookup. Unset: only localhost is skipped. Also point your CNAME target at the first host listed.
PLATFORM_HOSTS=

# --- Deployment split (public site and staff admin as two deployments of the same code) ---
# APP_MODE=public|admin|all. public: staff pages, /api/staff and staff sign-in answer 404. admin: only /staff, /api/staff, staff sign-in,
# logout, /api/health and static files are served; everything else answers 404. all: everything (local dev).
# Unset = all in development; public in production (fail closed). Any other value = public.
APP_MODE=
# Exact https origin of the admin host (e.g. https://admin.example.com.au). Used instead of APP_URL when APP_MODE=admin
# (CSRF origin check, Google redirect URI ${ADMIN_APP_URL}/api/auth/google/callback, secure cookies).
# FAILS CLOSED: with APP_MODE=admin and this unset, staff sign-in is off and every state-changing request answers 403.
ADMIN_APP_URL=

# --- Core ---
# Public origin of the site, exact (e.g. https://www.example.com.au). No path.
# FAILS CLOSED: login is off, CSRF-guarded POST routes return 403, checkout and offer links break.
# Must be set exactly in every environment.
APP_URL=http://localhost:3004

# PostgreSQL connection string. Also used by `npm run migrate`.
# FAILS CLOSED: the server throws "DATABASE_URL is required." on first request; migrate exits 1.
# Use a least-privilege app role (no TRUNCATE; see docs/DEPLOYMENT.md).
DATABASE_URL=postgres://user:password@localhost:5432/ownerlisting

# Number of trusted reverse-proxy hops in front of the app (1 to 10). Default 1 if unset or invalid.
# Not fail closed: a wrong value lets clients spoof their IP for rate limits. Set the real hop count.
TRUSTED_PROXY_HOPS=1

# --- Sign-in (Google OIDC) ---
# Session signing secret, at least 32 random characters (e.g. openssl rand -hex 32).
# FAILS CLOSED: if any of the next three or APP_URL is missing (or the secret is under 32 chars) sign-in is off.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3004
# Staff sign in with any Google account whose verified email has an active invite (admin page /staff/invites).
# First admin: comma list of emails. Each can sign in as super_admin only while no active super_admin exists (first setup or recovery).
# Empty = no bootstrap (then the first admin must be inserted into staff_invite in SQL).
STAFF_BOOTSTRAP_ADMIN_EMAILS=
# Server key sealing the offer link shown to a buyer (AES-256-GCM). 32 random bytes, base64. Generate with: openssl rand -base64 32
# Unset = offer links are refused (fail closed).
OFFER_LINK_TOKEN_KEY=
# Seals each listing's confidential lowest acceptable price (negotiation mandate floor) with AES-256-GCM. 32 random bytes, base64
# (openssl rand -base64 32). Fail closed: without it, owners cannot save a lowest price. Never rotate without re-sealing.
MANDATE_FLOOR_KEY=

# --- Payments (Westpac PayWay) ---
# FAILS CLOSED: all three required for checkout; checkout answers "not available yet" if any is missing.
# The adapter itself is still a stub until the merchant account and PayWay docs exist.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# HMAC-SHA256 secret for /api/webhooks/payway. FAILS CLOSED: the webhook rejects everything while unset.
PAYWAY_WEBHOOK_SECRET=

# --- Bank transfer and daily billing run ---
# Where customers send a bank transfer for an invoice (shown on the invoice with the invoice number as reference). All three or bank
# transfer stays off. BSB 6 digits, account number 6 to 10 digits. Staff confirm each transfer at /staff/finance.
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_BSB=
BANK_TRANSFER_ACCOUNT_NUMBER=
# Secret for POST /api/internal/billing/run (header x-cron-secret), called once a day: issues renewal invoices, expires unpaid plans and
# sends payment reminders. FAILS CLOSED: 503 while unset or under 32 characters.
BILLING_RUN_CRON_SECRET=
# The platform's ABN, printed on tax invoices (11 digits). Leave empty until the ABN is registered; the invoice then omits it.
SELLER_ABN=

# --- Buyer verification (SMS code and provider ID check) ---
# Key for hashing SMS codes (HMAC-SHA256), at least 32 random characters. FAILS CLOSED: mobile verification answers "not available yet" without it.
# Mobile verification also needs SMS settings (see the messaging section below); until they exist the port reports unconfigured.
SMS_CODE_SECRET=
# HMAC-SHA256 secret for /api/webhooks/id-check. FAILS CLOSED: the webhook rejects everything while unset.
# The ID check also needs a provider (src/adapters/id-check.ts); until one is wired in, starting a check answers "not available yet".
ID_CHECK_WEBHOOK_SECRET=

# --- Alert delivery (saved-search alerts by email/SMS) ---
# HMAC key for the one-click unsubscribe link in each alert, at least 32 random characters (openssl rand -base64 48).
# FAILS CLOSED: without it (or APP_URL) alerts have no unsubscribe link, so none is sent.
ALERT_UNSUBSCRIBE_KEY=
# Shared secret for POST /api/internal/alerts/run (header x-cron-secret), at least 32 characters. FAILS CLOSED: the route answers 503 while unset.
ALERT_CRON_SECRET=
# Optional. Signs OAuth bearer tokens for the public API (at least 32 characters). Falls back to SESSION_SECRET. Webhook delivery is POST /api/internal/webhooks/run with the same x-cron-secret as alerts.
API_TOKEN_SECRET=
# "console" writes ids only to the server log and sends nothing (development). Anything else, or console in production, means not configured.
# Real email/SMS delivery comes from the messaging settings above (database or environment); with none set, alerts record "not_configured" and send nothing.
ALERT_DELIVERY=

# --- Two-step sign-in (MFA): authenticator app or SMS code after Google sign-in. Required for owners and agents. ---
# Seals the authenticator secrets and keys the hashes of SMS and recovery codes. 32 random bytes, base64: openssl rand -base64 32
# FAILS CLOSED: unset or malformed = MFA set-up and sign-in checks are off, so owners and agents cannot finish signing in. Set it before deploying.
# SMS codes also need the SMS settings below; without them only the authenticator app is offered. Never rotate it casually: a new key
# makes every enrolled authenticator and recovery code unreadable (users then need a staff reset).
MFA_SECRET_KEY=

# Key (base64 of 32 bytes) that seals provider keys staff enter in the admin screen (Domain API at /staff/feeds). Optional: when unset,
# MFA_SECRET_KEY is used. FAILS CLOSED: with neither usable, the screen cannot save keys. Changing it makes saved keys unreadable (enter them again).
PROVIDER_CREDENTIAL_KEY=

# --- Email and SMS delivery (admin enters these in /staff/messaging; each variable below overrides the saved value for that field) ---
# Key sealing the SMS auth token and SMTP password saved in the database (AES-256-GCM). 32 random bytes, base64: openssl rand -base64 32
# FAILS CLOSED: unset = /staff/messaging shows "encryption key not configured" and saves nothing; saved secrets cannot be read, so SMS/email from the database stay off.
MESSAGING_SETTINGS_KEY=
# Facebook / Instagram lead ads keys saved in /staff/meta-leads are sealed with the first set of PROVIDER_CREDENTIAL_KEY, MESSAGING_SETTINGS_KEY, MFA_SECRET_KEY. FAILS CLOSED: none set = nothing saved, saved keys unreadable, Meta webhook answers 503.
# Optional overrides of the keys admins enter in /staff/meta-leads (App ID is only used by Test connection). The three secrets win over saved values when set.
# META_APP_ID=
# 32 random bytes, base64 (openssl rand -base64 32). Seals portal API keys and webhook secrets entered in /staff/listing-syndication. FAILS CLOSED: nothing is saved while unset.
SYNDICATION_SETTINGS_KEY=
# Shared secret for POST /api/internal/syndication/run (header x-cron-secret), at least 32 characters. FAILS CLOSED: the route answers 503 while unset.
SYNDICATION_CRON_SECRET=
# Channex channel manager (channex.io): one connection to Airbnb, Booking.com and Vrbo. Staff pick "Channex" as a portal's mode in
# /staff/listing-syndication. API key: Channex dashboard, user profile, API keys (needs an active subscription; staging.channex.io is free).
# FAILS CLOSED: a portal cannot be switched to Channex while the key is unset. CHANNEX_ENV=production uses app.channex.io, anything else staging.
CHANNEX_API_KEY=
CHANNEX_ENV=staging
# 32+ chars. Webhook POST /api/webhooks/channex is 404 until set. Use the secret of a Channex signing key (HMAC), or put this value in the
# webhook's custom header x-channex-webhook-secret. Bookings are also pulled on every syndication worker run, so the webhook is optional.
CHANNEX_WEBHOOK_SECRET=
# SMS (Twilio-compatible). Provider must be "twilio". Account SID (AC...), auth token (or API key secret, with SMS_API_KEY_SID=SK...).
# Sender: +61 number, alphanumeric sender ID (1-11 chars), or messaging service SID (MG...). FAILS CLOSED: any missing or invalid value = SMS off.
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_API_KEY_SID=
SMS_SENDER=
# Delivery status and STOP replies (Twilio webhooks, see docs/PROVIDER_KEYS.md). Needs an https APP_URL. Set this only when SMS_API_KEY_SID is used,
# because Twilio signs webhooks with the account auth token; without a signing token the webhooks answer 503.
SMS_WEBHOOK_AUTH_TOKEN=
# Estimated price of one text segment in cents (shown as "est." in /staff/messaging until the provider reports a price). Default 8.
SMS_COST_PER_SEGMENT_CENTS=
# Email (SMTP, TLS required: port 465 implicit TLS, otherwise STARTTLS). Host must be a public DNS name; port 25, 465, 587 or 2525. User and password come as a pair or not at all.
# FAILS CLOSED: host, port and from address are all required; otherwise email is off and the outbox records "not_configured".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Development only (ignored when NODE_ENV=production): "dev_file" writes every email to .dev-mail/ (open the .html in a browser) instead of sending it.
EMAIL_DELIVERY=

# --- Push notifications (each platform is independent; any missing or invalid value = that platform is off, nothing half-works) ---
# Browsers (Web Push). Generate the pair once: npx web-push generate-vapid-keys. Never rotate casually: browsers must subscribe again. Subject: mailto: or https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Android (Firebase Cloud Messaging HTTP v1). From a Firebase service account key: project id, client_email, private_key (keep the \n line breaks as written).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# iPhone (APNs token auth). From Apple Developer, Keys: the .p8 key (private key), its key id, your team id and the app's bundle id. APNS_PRODUCTION=1 for the live service.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=

# --- File storage and malware scan (self-hosted, no external account) ---
# STORAGE_DRIVER=local-disk stores files under STORAGE_LOCAL_DIR (absolute path; put it on an encrypted volume, not web-served). Anything else = uploads answer 503.
# Refused when NODE_ENV=production unless STORAGE_LOCAL_ALLOW_PRODUCTION=1.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
STORAGE_LOCAL_ALLOW_PRODUCTION=
# PRODUCTION: STORAGE_DRIVER=s3, default AWS S3 in Sydney (S3_REGION=ap-southeast-2, S3_ENDPOINT blank). Setup files: deploy/s3/README.md. Check: npm run check:s3.
# (Also works with S3-compatible services: Wasabi, Backblaze B2, R2.) All four of bucket, region and both keys are required.
# S3_ENDPOINT blank = AWS. S3_SSE = AES256 (default, S3-managed) or aws:kms (+ S3_KMS_KEY_ID). S3_CONDITIONAL_PUT=0 only if the service rejects If-None-Match.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_SSE=
S3_KMS_KEY_ID=
S3_CONDITIONAL_PUT=
# ClamAV clamd (TCP). Both must be set or uploads answer 503. Files over clamd's StreamMaxLength (25 MB default) are refused.
CLAMD_HOST=
CLAMD_PORT=
# Production: mutual TLS to the ClamAV VPS (deploy/clamav/README.md). Base64 PEM; set all three or none. Plain TCP is refused for remote hosts in production.
CLAMD_TLS_CA_B64=
CLAMD_TLS_CERT_B64=
CLAMD_TLS_KEY_B64=
# LOCAL TEST KIT ONLY (scripts/local-setup writes these): LOCAL_STORAGE_DIR (absolute path) stores uploads on your PC, and
# MALWARE_SCAN_DRIVER=local-noop accepts files without a scanner. Both are ignored when NODE_ENV=production or VERCEL is set.
LOCAL_STORAGE_DIR=
MALWARE_SCAN_DRIVER=
# Listing photos: smaller WebP copies are made when the sharp image library is installed (Next.js installs it). off = full size only.
IMAGE_VARIANTS=

# --- In-house ID photo review (photo ID + selfie, viewed by staff reviewers) ---
# AES-256-GCM key for ID images, exactly 32 random bytes in base64 (openssl rand -base64 32). Images are encrypted by the server before storage.
# FAILS CLOSED: unset or malformed (or storage/scanner above unconfigured) = the buyer page says "not available yet" and approval stays blocked.
# Losing or changing this key makes every stored ID image unreadable. Keep it in a secrets manager, never in the repo or logs.
ID_IMAGE_KEY=
# Shared secret for POST /api/internal/id-images/retention (header x-cron-secret), at least 32 characters. Run daily.
# FAILS CLOSED: while unset (or under 32 characters) the route answers 503 and no ID images are collected (the page says "not available yet").
ID_RETENTION_CRON_SECRET=
# Shared secret for POST /api/internal/accounts/retention (header x-cron-secret), at least 32 characters. Run daily.
# Makes account deletions final after the 30-day recovery window and clears name and email after the 7-year retention period.
# FAILS CLOSED: while unset (or under 32 characters) the route answers 503; deleted accounts stay restorable by date check alone.
ACCOUNT_RETENTION_CRON_SECRET=
# Shared secret for POST /api/internal/reports/run (header x-cron-secret), at least 32 characters. Run hourly.
# Runs the staff report schedules that are due and emails each report to its owner. Email must also be set up (/staff/messaging).
# FAILS CLOSED: while unset (or under 32 characters) the route answers 503 and no scheduled report is sent.
REPORTS_CRON_SECRET=
# Shared secret for POST /api/internal/staff-automation/run (header x-cron-secret), at least 32 characters. Called every 15 minutes by .github/workflows/staff-automation.yml.
# Applies workflow rules, sends due campaigns in batches and runs scheduled tasks. FAILS CLOSED: while unset (or under 32 characters) the route answers 503.
STAFF_AUTOMATION_CRON_SECRET=
# Shared secret for POST /api/internal/listing-bulk/run (header x-cron-secret), at least 32 characters. Run every minute.
# Finishes staff bulk listing runs whose worker stopped (a deploy or restart part way). FAILS CLOSED: while unset the route answers 503.
LISTING_BULK_CRON_SECRET=
# --- Agent invitation reminders (hourly job, docs/DEPLOYMENT.md 4c) ---
# Secret (32+ chars) for POST /api/internal/appointments/reminders. FAILS CLOSED: while unset the route answers 503 and no reminders go out.
APPOINTMENT_REMINDER_CRON_SECRET=
# Secret (32+ chars) for POST /api/internal/job-reminders (hourly): reminds contractors of confirmed jobs. FAILS CLOSED: while unset the route answers 503.
JOB_REMINDER_CRON_SECRET=

# --- Automations (workflows and campaigns, docs/AUTOMATION.md) ---
# Optional fallback: the secret can be generated in /staff/cron-secrets instead (stored there, which wins over this). 32+ chars for POST /api/internal/automations/run, called every 10 minutes. FAILS CLOSED: while unset the route answers 503 and no waiting runs advance.
AUTOMATION_CRON_SECRET=
# DocuSign signer reminders (hourly job, 32+ chars, same value as the repository secret).
SIGNING_REMINDER_CRON_SECRET=
# Shared secret for POST /api/internal/agent-reports/run (header x-cron-secret), at least 32 characters. Run hourly.
# Emails each agent's scheduled reports (daily 8am, Mondays, or the 1st, Brisbane time) to their own account email. APP_URL builds the link.
# FAILS CLOSED: while unset (or under 32 characters) the route answers 503 and nothing is sent.
AGENT_REPORT_CRON_SECRET=
# Shared secret for POST /api/internal/open-inspections/reminders (header x-cron-secret), at least 32 characters. Run every 15 minutes (.github/workflows/open-inspection-reminders.yml).
# Sends buyers the 24 hour and 1 hour open inspection reminders, each once. FAILS CLOSED: while unset (or under 32 characters) the route answers 503 and nothing is sent.
OPEN_INSPECTION_CRON_SECRET=
# Shared secret for POST /api/internal/market-shifts/run (header x-cron-secret), at least 32 characters. Run daily.
# Elena tells each agent about notable changes in the areas they act in (prices, activity, time to sell, buyer interest), once per shift per month.
# FAILS CLOSED: while unset (or under 32 characters) the route answers 503 and nothing is sent.
MARKET_SHIFT_CRON_SECRET=
# --- Elena learning loop ---
# Header secret for POST /api/internal/elena-learning/run (body {"job":"weekly"|"monthly"}). Weekly: record deal outcomes, refresh patterns.
# Monthly: also propose a new learned version (staff activate it at /staff/elena-training). FAILS CLOSED: 503 while unset or under 32 characters.
ELENA_LEARNING_CRON_SECRET=
# --- ABN Lookup (Australian Business Register, free web service) ---
# Authentication GUID emailed by the ABR after registering. FAILS CLOSED: when unset, ABNs are only checksum-checked and recorded as
# "format valid, not confirmed with ABR"; staff must review. Never logged or put in errors/audit.
ABN_LOOKUP_GUID=

# --- Property data feeds (/staff/feeds) ---
# Domain API (developer.domain.com.au): a client with a listings package. OAuth client credentials. FAILS CLOSED: until both are
# set, Domain connections fail their runs with "not set up". Agency CRM (REAXML) feeds need no key here.
DOMAIN_CLIENT_ID=
DOMAIN_CLIENT_SECRET=
# Secret the scheduler sends as header x-cron-secret to POST /api/internal/feeds/run (32+ chars; openssl rand -base64 48).
# FAILS CLOSED: 503 while unset or short. Same value as the PROPERTY_FEEDS_CRON_SECRET repository secret.
FEED_CRON_SECRET=

# --- Mortgage rates (calculator) ---
# Secret the scheduler sends as header x-cron-secret to POST /api/internal/mortgage-rates/run (32+ chars; openssl rand -base64 48).
# FAILS CLOSED: 503 while unset or short. Same value as the MORTGAGE_RATES_CRON_SECRET repository secret.
MORTGAGE_RATES_CRON_SECRET=

# --- Lead ads (/staff/ad-leads) ---
# Facebook/Instagram Lead Ads. FAILS CLOSED: the webhook answers 503 until all three are set.
# META_APP_SECRET: the Meta app's secret (verifies X-Hub-Signature-256). META_WEBHOOK_VERIFY_TOKEN: any long random string you also enter when
# subscribing the Page's leadgen webhook. META_PAGE_ACCESS_TOKEN: long-lived Page token with leads_retrieval, pages_manage_metadata, pages_show_list.
# Google lead form extensions need no key here: staff issue a webhook key per source at /staff/ad-leads.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# --- Address suggestions (listing form street address) ---
# Google Places API (New) key: Google Cloud console, enable "Places API (New)", restrict the key to that API. Server-side only.
# When unset, suggestions come from Photon (OpenStreetMap data): the public instance is fair-use, fine for testing and a small beta,
# not for launch traffic. ADDRESS_PHOTON_URL points at a self-hosted Photon instead. ADDRESS_LOOKUP=off turns suggestions off.
GOOGLE_PLACES_API_KEY=
ADDRESS_PHOTON_URL=
ADDRESS_LOOKUP=

# --- Not read by code yet (providers not chosen; there is no env key to set) ---
# AI engine: not configured, features report "off".
# Staff Google Workspace domain (hd claim): not implemented; staff first-login linking waits on it.
# When one of these is wired, add its key above in the same PR; the test then enforces it.

# --- Local test kit only (docs/LOCAL_TEST.md). NEVER set in a real deployment ---
# DEV_LOGIN=1 enables /dev-login and POST /api/dev/login (sign in as seeded demo accounts, no Google). Works only when ALL hold:
# NODE_ENV is not production, VERCEL is unset, APP_URL (and ADMIN_APP_URL in admin mode) are localhost, and the request Host is localhost/127.0.0.1/[::1].
# Anything else answers 404. Not fail closed in the usual sense: unset = off.
DEV_LOGIN=
# Set automatically by Vercel. Read only to REFUSE dev sign-in there. Never set it yourself.
VERCEL=
# Build folder for next dev; the local test kit uses a second folder (.next-admin) for the admin instance. Default .next.
NEXT_DIST_DIR=

# --- Self-hosted AI (see docs/LOCAL_TEST.md "Optional: AI with Ollama") ---
# Two keys, both needed: AI_ENGINE=ollama here AND a super admin turning AI on at /staff/ai (default OFF). Otherwise every AI feature
# says "AI unavailable" and the rules-only features keep working. No outside AI account is ever used.
# AI_ENGINE: empty = no AI (default). ollama = a model server speaking the Ollama HTTP API (/api/chat, /api/tags).
# AI_ENGINE=
# Model server address, no path. Default http://127.0.0.1:11434. FAILS CLOSED: only localhost or a private-network IP is accepted
# (link-local and cloud metadata addresses never are); a host name or public address needs AI_ALLOW_REMOTE_ENDPOINT=1 and https://.
# AI_ENDPOINT=
# Model name exactly as `ollama list` shows it. Default llama3.1:8b.
# AI_MODEL=
# AI_VISION_MODEL=   # optional self-hosted vision model so Elena can look at listing photos (e.g. llama3.2-vision)
# Per-request timeout in ms (1000 to 120000, default 30000), output cap in tokens (16 to 2048, default 512),
# requests at once per server (1 to 8, default 2; extra requests get "AI unavailable" instead of queueing).
# AI_TIMEOUT_MS=
# AI_MAX_TOKENS=
# AI_MAX_CONCURRENCY=
# Set to 1 only for our own remote model server (https). Unset = local/private only.
# AI_ALLOW_REMOTE_ENDPOINT=

# --- Price guidance comparables (owner-only price range on the listing edit page) ---
# Empty = no comparables source, so the card says "Estimate unavailable" (default). file = read PRICE_DATA_FILE, a JSON array of
# comparable sales or leases (see src/domain/price-guidance.ts Comparable). Use only data the platform is licensed to use.
# PRICE_DATA_SOURCE=
# PRICE_DATA_FILE=

# --- Property data providers (MLS, Zillow). Skeleton only: the integrations themselves come once specs and credentials arrive. ---
# Every provider is OFF until its key AND base URL are set. `npm run check:providers` and the startup log report what is missing (names only).
# MLS feed: API key and base URL from the MLS/data-licence provider (https, no query string). MLS_API_KEY_HEADER: only if the provider
# wants a header other than Authorization: Bearer (for example X-Api-Key). MLS_HEALTH_PATH: path used by the staff health probe (default /).
# MLS_RATE_PER_SECOND: calls per second we allow ourselves (default 5). MLS_WEBHOOK_SECRET: 32+ characters, shared with the provider
# for /api/webhooks/mls (openssl rand -base64 48); unset = the webhook answers 503.
MLS_API_KEY=
MLS_API_BASE_URL=
# MLS_API_KEY_HEADER=
# MLS_HEALTH_PATH=
# MLS_RATE_PER_SECOND=
MLS_WEBHOOK_SECRET=
# Zillow API (same rules as MLS, no webhook).
ZILLOW_API_KEY=
ZILLOW_API_BASE_URL=
# ZILLOW_API_KEY_HEADER=
# ZILLOW_HEALTH_PATH=
# ZILLOW_RATE_PER_SECOND=
# Push delivery-status webhook (/api/webhooks/push-status?provider=fcm|apns): 32+ characters, shared with whatever relays delivery receipts.
PUSH_STATUS_WEBHOOK_SECRET=
# Encrypts per-agent / per-team provider secrets in provider_credentials. 32 random bytes in base64 (openssl rand -base64 32). Never reuse another key.
PROVIDER_CREDENTIAL_KEY=

# --- DocuSign e-signing (docs/DOCUSIGN.md) ---
# SIGNING_PROVIDER=docusign sends new documents through DocuSign. Unset keeps the built-in click-to-sign. With docusign selected and keys missing, new documents are refused.
# SIGNING_PROVIDER=
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# RSA private key in PEM form, with \n for line breaks.
# DOCUSIGN_PRIVATE_KEY=
# HMAC key from DocuSign Connect, used to authenticate /api/webhooks/docusign.
# DOCUSIGN_CONNECT_HMAC_KEY=
# Defaults are the demo account: https://demo.docusign.net/restapi and account-d.docusign.com
# DOCUSIGN_BASE_PATH=
# DOCUSIGN_OAUTH_HOST=

# --- Team payouts (Stripe Connect) ---
# Pays approved team commissions to members' bank accounts. Off unless PAYOUTS_ENABLED=1 and a key is set.
# Test keys (sk_test_...) only: a live key is refused unless PAYOUTS_ALLOW_LIVE=1, which needs pen test + counsel sign-off.
PAYOUTS_ENABLED=
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint /api/webhooks/stripe. FAILS CLOSED while unset.
STRIPE_WEBHOOK_SECRET=
PAYOUTS_ALLOW_LIVE=

# AI tour videos (Hedra). HEDRA_API_KEY turns generation on; HEDRA_WEBHOOK_URL (optional, https) is where Hedra reports completion
# (https://YOUR-SITE/api/webhooks/hedra); VIDEO_CRON_SECRET (32+ chars) guards /api/internal/videos/tick.
# Buyer payment uses hosted Stripe Checkout: VIDEO_PAYMENTS_ENABLED=1, STRIPE_SECRET_KEY (test key only until sign-off; live needs
# VIDEO_PAYMENTS_ALLOW_LIVE=1) and STRIPE_VIDEO_WEBHOOK_SECRET for the endpoint /api/webhooks/stripe-video.
# A video that fails for good is refunded to the buyer through the Stripe Refunds API (same key and switch; retried by the video queue tick).
# Prices in AUD cents: VIDEO_TEAM_COST_CENTS (default 500) and VIDEO_BUYER_PRICE_CENTS (default 600). Videos need file storage (STORAGE_DRIVER).
HEDRA_API_KEY=
HEDRA_WEBHOOK_URL=
VIDEO_CRON_SECRET=
VIDEO_PAYMENTS_ENABLED=
VIDEO_PAYMENTS_ALLOW_LIVE=
STRIPE_VIDEO_WEBHOOK_SECRET=
VIDEO_TEAM_COST_CENTS=
VIDEO_BUYER_PRICE_CENTS=
# Elena lead qualifier (docs/ELENA_LEAD_QUALIFIER.md). Off unless LEAD_QUALIFIER=on.
LEAD_QUALIFIER=
# Shared secret for POST /api/internal/leads/followups (header x-cron-secret), 32+ characters. Run every 15 minutes.
LEAD_CRON_SECRET=
# Shared secret for POST /api/internal/crm-leads/reminders (header x-cron-secret), 32+ characters. Run hourly (buyer-lead follow-up reminders).
CRM_LEAD_CRON_SECRET=
# Shared secret for POST /api/webhooks/email-inbound (header x-inbound-secret), 32+ characters.
LEAD_EMAIL_INBOUND_SECRET=
# Contractors reply to job emails with JOB-5001 and files attached. Inbound parse posts to /api/webhooks/job-email with header x-inbound-secret.
# 32+ random characters. Unset = the endpoint answers 503. See docs/CONTRACTORS.md.
# Elena's conversational replies use POST /api/webhooks/job-reply with the same secret and header; the forwarder must set "verified": true only when DMARC-aligned DKIM or SPF passed for the From address.
JOB_EMAIL_INBOUND_SECRET=

# Public support mailbox shown on /privacy and /support. Unset shows a PLACEHOLDER address; set the real one before launch.
# SUPPORT_EMAIL=

# Text recognition for scanned PDFs and photographed documents (Elena paperwork and pre-qualification), done on this machine with Tesseract. Default on; set false to switch it off. No keys, nothing leaves the server.
# OCR_ENABLED=true
