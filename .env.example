# Never put real credentials in source control.
NODE_ENV=development
INVESTMENT_MODULE_ENABLED=false
DATABASE_URL=postgres://user:password@localhost:5432/ownerlisting
# Random string of 32+ characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Google Cloud console > Credentials > OAuth client (web). Redirect URI: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3004
# Server key sealing the offer link shown to a buyer (AES-256-GCM). 32 random bytes, base64. Generate with: openssl rand -base64 32
# Unset = offer links are refused (fail closed).
OFFER_LINK_TOKEN_KEY=
