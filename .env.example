# OwnerListing environment. Copy to .env (never commit real values).
# Never put real credentials in source control.
NODE_ENV=development
# Reserved flag, not read by code (investment module is hard-disabled until Gate G4). Keep false.
INVESTMENT_MODULE_ENABLED=false

# "FAILS CLOSED" = when unset the feature refuses to work; nothing is silently allowed.
# tests/env-example.test.ts checks every env key read in src/, app/ and scripts/ is listed here.

# --- Brand (one source of truth: src/config/brand.ts) ---
# Shown in titles, header, home page and consent text. NEXT_PUBLIC_SITE_NAME wins over SITE_NAME. Default OwnerListing. Not fail closed.
# NEXT_PUBLIC_* is baked in at build time on Vercel: change it, then redeploy.
NEXT_PUBLIC_SITE_NAME=
SITE_NAME=
NEXT_PUBLIC_SITE_TAGLINE=
SITE_TAGLINE=

# --- Deployment split (public site and staff admin as two deployments of the same code) ---
# APP_MODE=public|admin|all. public: staff pages, /api/staff and staff sign-in answer 404. admin: only /staff, /api/staff, staff sign-in,
# logout, /api/health and static files are served; everything else answers 404. all: everything (local dev).
# Unset = all in development; public in production (fail closed). Any other value = public.
APP_MODE=
# Exact https origin of the admin host (e.g. https://admin.example.com.au). Used instead of APP_URL when APP_MODE=admin
# (CSRF origin check, Google redirect URI ${ADMIN_APP_URL}/api/auth/google/callback, secure cookies).
# FAILS CLOSED: with APP_MODE=admin and this unset, staff sign-in is off and every state-changing request answers 403.
ADMIN_APP_URL=

# --- Core ---
# Public origin of the site, exact (e.g. https://www.example.com.au). No path.
# FAILS CLOSED: login is off, CSRF-guarded POST routes return 403, checkout and offer links break.
# Must be set exactly in every environment.
APP_URL=http://localhost:3004

# PostgreSQL connection string. Also used by `npm run migrate`.
# FAILS CLOSED: the server throws "DATABASE_URL is required." on first request; migrate exits 1.
# Use a least-privilege app role (no TRUNCATE; see docs/DEPLOYMENT.md).
DATABASE_URL=postgres://user:password@localhost:5432/ownerlisting

# Number of trusted reverse-proxy hops in front of the app (1 to 10). Default 1 if unset or invalid.
# Not fail closed: a wrong value lets clients spoof their IP for rate limits. Set the real hop count.
TRUSTED_PROXY_HOPS=1

# --- Sign-in (Google OIDC) ---
# Session signing secret, at least 32 random characters (e.g. openssl rand -hex 32).
# FAILS CLOSED: if any of the next three or APP_URL is missing (or the secret is under 32 chars) sign-in is off.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3004
# Server key sealing the offer link shown to a buyer (AES-256-GCM). 32 random bytes, base64. Generate with: openssl rand -base64 32
# Unset = offer links are refused (fail closed).
OFFER_LINK_TOKEN_KEY=

# --- Payments (Westpac PayWay) ---
# FAILS CLOSED: all three required for checkout; checkout answers "not available yet" if any is missing.
# The adapter itself is still a stub until the merchant account and PayWay docs exist.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# HMAC-SHA256 secret for /api/webhooks/payway. FAILS CLOSED: the webhook rejects everything while unset.
PAYWAY_WEBHOOK_SECRET=

# --- Buyer verification (SMS code and provider ID check) ---
# Key for hashing SMS codes (HMAC-SHA256), at least 32 random characters. FAILS CLOSED: mobile verification answers "not available yet" without it.
# Mobile verification also needs an SMS provider (src/adapters/sms.ts); until one is wired in the port reports unconfigured.
SMS_CODE_SECRET=
# HMAC-SHA256 secret for /api/webhooks/id-check. FAILS CLOSED: the webhook rejects everything while unset.
# The ID check also needs a provider (src/adapters/id-check.ts); until one is wired in, starting a check answers "not available yet".
ID_CHECK_WEBHOOK_SECRET=

# --- Alert delivery (saved-search alerts by email/SMS) ---
# HMAC key for the one-click unsubscribe link in each alert, at least 32 random characters (openssl rand -base64 48).
# FAILS CLOSED: without it (or APP_URL) alerts have no unsubscribe link, so none is sent.
ALERT_UNSUBSCRIBE_KEY=
# Shared secret for POST /api/internal/alerts/run (header x-cron-secret), at least 32 characters. FAILS CLOSED: the route answers 503 while unset.
ALERT_CRON_SECRET=
# "console" writes ids only to the server log and sends nothing (development). Anything else, or console in production, means not configured.
# A real email/SMS provider still has to be chosen and wired in src/adapters/alert-delivery.ts.
ALERT_DELIVERY=

# --- File storage and malware scan (self-hosted, no external account) ---
# STORAGE_DRIVER=local-disk stores files under STORAGE_LOCAL_DIR (absolute path; put it on an encrypted volume, not web-served). Anything else = uploads answer 503.
# Refused when NODE_ENV=production unless STORAGE_LOCAL_ALLOW_PRODUCTION=1.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
STORAGE_LOCAL_ALLOW_PRODUCTION=
# ClamAV clamd (TCP). Both must be set or uploads answer 503. Files over clamd's StreamMaxLength (25 MB default) are refused.
CLAMD_HOST=
CLAMD_PORT=

# --- Not read by code yet (providers not chosen; there is no env key to set) ---
# Email delivery and SMS for alerts, AI engine: not configured, features report "off".
# ABN Lookup access key (GUID): src/adapters/abr-lookup.ts takes it as a parameter; no env wiring yet.
# Staff Google Workspace domain (hd claim): not implemented; staff first-login linking waits on it.
# When one of these is wired, add its key above in the same PR; the test then enforces it.
